{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypersnap-quorum",
  "account_id": "e320a5a80611f9a30148d452929b1fb1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "routes": [{ "pattern": "opencaster.org", "custom_domain": true }, { "pattern": "quorum.arca.computer", "custom_domain": true }],
  "observability": { "enabled": false },
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "hypersnap-quorum-media" }],
  "durable_objects": { "bindings": [{ "name": "MEDIA_QUOTA", "class_name": "MediaUploadQuota" }] },
  "migrations": [{ "tag": "media-quota-v1", "new_sqlite_classes": ["MediaUploadQuota"] }]
}
