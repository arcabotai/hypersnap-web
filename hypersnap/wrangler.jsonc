{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypersnap-quorum",
  "account_id": "e320a5a80611f9a30148d452929b1fb1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "routes": [{ "pattern": "quorum.arca.computer", "custom_domain": true }],
  "observability": { "enabled": false }
}
